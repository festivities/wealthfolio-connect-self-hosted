+/// Whether a broker trade's unit price may be written as a market quote for the
+/// asset it traded.
+///
+/// Quote selection keys on the asset and day and never inspects the quote's own
+/// currency, so a price expressed in anything other than the asset's quote
+/// currency would be read as though it were. A fiat-funded crypto purchase is
+/// priced in the fiat transaction currency (PHP, say) while the asset is quoted
+/// in USD; persisting that price as a BROKER quote would value the asset in PHP.
+///
+/// Fails closed: when either currency is unknown — the asset lookup failed, or a
+/// currency is blank — the price is not seeded. A skipped quote is harmless (it
+/// is re-derived on the next sync) whereas a quote in the wrong currency is read
+/// as authoritative.
+fn trade_price_quotes_asset(price_currency: &str, asset_quote_ccy: Option<&str>) -> bool {
+    let Some(asset_quote_ccy) = asset_quote_ccy.map(str::trim).filter(|ccy| !ccy.is_empty()) else {
+        return false;
+    };
+    let price_currency = price_currency.trim();
+    if price_currency.is_empty() {
+        return false;
+    }
+    price_currency.eq_ignore_ascii_case(asset_quote_ccy)
+}
